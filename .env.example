# ============================================================================
# Crypto Intelligence Terminal – environment template (Step 6.2)
# Copy to `.env` and fill in the credentials you have.  Everything without a
# credential works out of the box: the platform degrades gracefully when a
# social platform is not configured (see backend/workers/social_ingestion.py).
# ============================================================================

# ------------------------------------------------------------------ runtime
ENVIRONMENT=production            # development | staging | production
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR

# ---------------------------------------------------------------- PostgreSQL
POSTGRES_USER=crypto
POSTGRES_PASSWORD=crypto          # CHANGE ME in production
POSTGRES_DB=crypto_intel
POSTGRES_HOST=localhost           # service name inside docker network: timescaledb
POSTGRES_PORT=5432

# -------------------------------------------------------------------- Redis
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------- API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=2                     # uvicorn worker processes
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATELIMIT_ENABLED=true
RATELIMIT_DEFAULT=120/minute

# ------------------------------------------------------------- watchlist
# Comma separated base assets that the whole platform ingests and scores.
SYMBOLS=BTC,ETH,SOL,BNB,XRP,DOGE,ADA
QUOTE_ASSET=USDT
EXCHANGE_ID=binance               # ccxt exchange used for WS + REST feeds

# ---------------------------------------------------- ingestion tuning
MARKET_FEED_RESOLUTION=1m         # base candle grain stored in market_ohlcv
DERIVATIVE_POLL_SECONDS=60        # funding/OI/long-short polling cadence
SOCIAL_POLL_SECONDS=90            # social collection cadence per cycle
SOCIAL_LOOKBACK_POSTS=80          # max posts pulled per platform per symbol

# ------------------------------------------------------------ NLP / ML
SENTIMENT_MODEL_ID=cardiffnlp/twitter-roberta-base-sentiment-latest
SENTIMENT_MODEL_FALLBACK_ID=ProsusAI/finbert
NLP_DEVICE=cpu                    # cpu | cuda | mps
NLP_BATCH_SIZE=32
SOCIAL_ALERT_MIN_CONFIDENCE=0.65  # |p| and confidence thresholds that mark
SOCIAL_ALERT_MIN_ABS_POLARITY=0.45  # a social record as a high-impact alert

# --------------------------------------------------------- quant engine
RSI_PERIOD=14
VOLATILITY_WINDOW_DAYS=30
LOW_LIQUIDITY_VOLUME_THRESHOLD=1000

# --------------------------------------------------------- data retention
OHLCV_RETENTION_DAYS=180
SENTIMENT_RETENTION_DAYS=180
DERIVATIVE_RETENTION_DAYS=180
SIGNAL_RETENTION_DAYS=365

# ------------------------------------------------------------ credentials
# Twitter API v2 bearer token (Essential+ tier).  Optional.
TWITTER_BEARER_TOKEN=
# Reddit script application credentials (https://www.reddit.com/prefs/apps). Optional.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=crypto-intel-terminal/1.0 (research)

# --------------------------------------------------------------- frontend
# URLs as seen from the BROWSER (host-published ports), not container names.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ------------------------------------------------------------ worker pool
CELERY_CONCURRENCY=16
